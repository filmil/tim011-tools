load("//build:macros.bzl", "tim011_emu_run")  # Probably needs reshuffling.
load("//build:sdcc.bzl", "sdcc_z180_c_binary")
load("//build/tim011-image:rules.bzl", "tim011_disk_image")

sdcc_z180_c_binary(
    name = "hw",
    srcs = ["hello_world.c"],
)

tim011_disk_image(
    name = "img",
    base_image = "@mame_docker//:TIM011-Kit.img",
    binaries = [":hw"],
)

tim011_emu_run(
    name = "emu",
    image = ":img",
    program = "hw",
)
