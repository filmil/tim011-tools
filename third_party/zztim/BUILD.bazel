# Only `requirement` is used. The other three symbols were imported but never
# called, and modern rules_python no longer exports `entry_point` at all.
load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# bazel run //third_party/zztim:timtile -- -h
py_binary(
    name = "timtile",
    srcs = ["@zztim//:timtile"],
    deps = [
        requirement("pypng"),
    ],
)

# bazel run //third_party/zztim:timpng -- -h
py_binary(
    name = "timpng",
    srcs = ["@zztim//:timpng"],
    deps = [
        requirement("pypng"),
    ],
)

# bazel run //third_party/zztim:timfont8 -- -h
py_binary(
    name = "timfont8",
    srcs = ["@zztim//:timfont8"],
    deps = [
        requirement("pypng"),
    ],
)

# bazel run //third_party/zztim:timfont -- -h
py_binary(
    name = "timfont",
    srcs = ["@zztim//:timfont"],
    deps = [
        requirement("pypng"),
    ],
)

# bazel run //third_party/zztim:timdisk
sh_binary(
    name = "timdisk",
    srcs = ["@zztim//:timdisk.sh"],
    data = [
        "@cpmtools//:cpmcp",
        "@cpmtools//:cpmls",
    ],
    # This is only set when the binary is run using `bazel run`.
    env = {
        "CPMLS": "$(location @cpmtools//:cpmls)",
        "CPMCP": "$(location @cpmtools//:cpmcp)",
        # Skip interactive prompting.
        "FORCE": "1",
    },
)
